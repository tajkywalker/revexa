# ─── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://serverix:password@localhost:5432/serverix_db"

# ─── NextAuth ──────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# ─── Discord OAuth ─────────────────────────────────────
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ─── Hytale Server API ────────────────────────────────
HYTALE_SERVER_HOST="play.aunaria.net"
HYTALE_SERVER_PORT="25565"
HYTALE_RCON_PASSWORD="your-rcon-password"
HYTALE_API_KEY="your-plugin-api-key"

# ─── App config ────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_NAME="Aunaria"
NEXT_PUBLIC_SERVER_IP="play.aunaria.net"
